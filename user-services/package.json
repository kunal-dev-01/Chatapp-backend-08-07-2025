{
  "name": "user-service",
  "version": "1.0.0",
  "description": "Advanced User Service for Chat Application Microservices",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc && tsc-alias",
    "start": "node dist/server.js",
    "start:dev": "tsx src/server.ts",
    "clean": "rimraf dist",
    "type-check": "tsc --noEmit",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "docker:build": "docker build -t chat-api-gateway .",
    "docker:run": "docker run -p 3000:3000 chat-api-gateway"
  },
  "keywords": [
    "user-service",
    "microservices",
    "nodejs",
    "express",
    "mongoose",
    "cloudfront",
    "aws s3"
  ],
  "author": "Kunal Singh",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@aws-sdk/client-cloudfront": "^3.863.0",
    "@aws-sdk/client-s3": "^3.863.0",
    "@aws-sdk/client-ses": "^3.863.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.0",
    "mongoose": "^7.4.0",
    "multer": "^2.0.2",
    "sharp": "^0.34.3",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.2",
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.8",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^20.10.4",
    "@typescript-eslint/eslint-plugin": "^6.13.1",
    "@typescript-eslint/parser": "^6.13.1",
    "jest": "^29.7.0",
    "rimraf": "^5.0.5",
    "tsc-alias": "^1.8.8",
    "tsx": "^4.6.2"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
